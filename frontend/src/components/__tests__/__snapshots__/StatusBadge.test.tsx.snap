// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StatusBadge > renders ACCEPTED consistently 1`] = `
<span
  class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium whitespace-nowrap border-success/15 bg-success-soft text-success"
  data-slot="badge"
  data-status="ACCEPTED"
  data-tone="success"
>
  <span
    aria-hidden="true"
    class="size-1.5 rounded-full bg-current"
  />
  Accepted
</span>
`;

