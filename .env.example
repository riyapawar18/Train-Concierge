# TrainConcierge environment template.
# Spring Boot does not read this file automatically: copy the values into your
# shell / IDE run configuration, or export them before starting the backend.

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/trainconcierge?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# --- JWT ---
# Any sufficiently long random string. Generate one, never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# --- CORS ---
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional RailRadar provider ---
# Leave empty to use the seeded local database only.
RAILRADAR_API_KEY=
