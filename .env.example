# Backend (required unless noted)
# Copy to backend/.env (or keep it here in the repository root) — the backend imports
# that file at startup, so exported shell variables are optional. Never commit secrets.
DB_URL=jdbc:mysql://localhost:3306/trainconcierge?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=trainconcierge
DB_PASSWORD=change-me
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
# Email relay. Gmail SMTP is the default; point MAIL_HOST/MAIL_PORT at any other provider.
# A Gmail mailbox needs an App Password, not the account password:
#   Google account > Security > 2-Step Verification > App passwords > (type: Mail)
# and paste the 16 characters without spaces. Both MAIL_USERNAME and MAIL_PASSWORD must
# be set, otherwise every email is recorded as "not configured" instead of being sent.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional alias for MAIL_USERNAME, kept for compatibility with earlier deploys.
MAIL_USER=
MAIL_STARTTLS=true
# Leave blank to send from MAIL_USERNAME. Gmail rejects a From address it does not own.
MAIL_FROM=
# Optional: set false to skip sending email entirely (rows stay FAILED with "Email not configured").
MAIL_ENABLED=true
# Optional SMTP tuning; the defaults below are what the backend uses.
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS_REQUIRED=true
# MAIL_CONNECT_TIMEOUT_MS=10000
# MAIL_READ_TIMEOUT_MS=15000
# MAIL_WRITE_TIMEOUT_MS=15000
# Optional: how often the retry job re-sends failed mail (3 attempts per notification).
# MAIL_RETRY_DELAY_MS=60000
# MAIL_RETRY_INITIAL_DELAY_MS=60000
# Optional: recipient used only by the live Gmail send test (GmailLiveSendTest).
# MAIL_TEST_TO=
# Optional: how long a forgot-password link stays usable, in minutes.
# RESET_TOKEN_TTL_MINUTES=30
APP_FRONTEND_ORIGIN=http://localhost:5173
# Optional: set to seed the demo accounts (one admin, five passengers; profile dev,demo).
# No default is shipped.
DEMO_PASSWORD=
# Optional: set false to skip the simulated catalog rows (profile dev,demo).
APP_DEMO_CATALOG_ENABLED=true
# Optional: persistent local demo database (profile local-h2,demo). Defaults to ./data.
# LOCAL_DB_URL=jdbc:h2:file:./data/trainconcierge;MODE=MySQL;DB_CLOSE_DELAY=-1;NON_KEYWORDS=USER
# Optional: one-time admin provisioning (profile dev,provision-admin). Leave unset normally.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Frontend (Vite reads .env from frontend/)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_PROXY_TARGET=http://localhost:8080
